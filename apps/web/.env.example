# CanguPay Web - Stellar Soroban Testnet Configuration
# P0-08: Only public variables and placeholders are allowed in this file.

# Target Stellar Network (Fail-closed: requires exact official Testnet passphrase)
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# RPC & API Endpoints
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Soroban Core Contract Identifiers (P0 Escrow)
# Placeholders: populated once deployed and read via RPC
NEXT_PUBLIC_ESCROW_CONTRACT_ID=
NEXT_PUBLIC_CPUSD_CONTRACT_ID=

# B2B Settlement Asset (Stellar Testnet)
NEXT_PUBLIC_DEMO_ASSET_CODE=CPUSD

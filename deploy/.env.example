# Configuracion de la pila docker de CanguPay.
#
# Copiar a .env en la raiz del repo y completar. El .env esta en .gitignore:
# no lo subas nunca.
#
#   cp deploy/.env.example .env

# ---------- frontend ----------
# El puerto en el host donde se publica la web.
WEB_PORT=3000

# Estas dos se COMPILAN dentro de la imagen del frontend: cambiarlas exige
# reconstruir, no reiniciar. Si solo cambias el .env y haces restart, no pasa
# nada y es facil confundirse.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Sin contrato la web cae en modo vista previa, con datos de ejemplo.
# Con contrato, lee el real.
NEXT_PUBLIC_ESCROW_CONTRACT_ID=

# ---------- agente ----------
# RPC y red contra la que opera.
CANGUPA_RPC_URL=https://soroban-testnet.stellar.org
CANGUPA_NETWORK="Test SDF Network ; September 2015"

CANGUPA_CONTRACT_ID=
# Ruta al bundle de evidencia que revisa el motor.
CANGUPA_BUNDLE=fixtures/pass/bundle.json
# Importe esperado en unidades minimas del token, tal cual lo declara el
# contrato en config.amount. El motor se niega a firmar si no coincide.
CANGUPA_EXPECTED_AMOUNT=10000000000
# OJO: es la direccion del token del contrato (C...), no un codigo de divisa
# como CPUSD. Si se pone el codigo, el keeper se rechaza a si mismo.
CANGUPA_EXPECTED_CURRENCY=

# Secreto de la cuenta engine, en formato S... Es la clave que firma. Viene del
# gestor de secretos del servidor; jamas se escribe en un fichero del repo.
CANGUPA_ENGINE_SECRET=
# Alternativa al secreto en entorno: un keyfile montado por docker secrets.
# CANGUPA_ENGINE_KEYFILE=/run/secrets/engine

CANGUPA_POLL_SECONDS=10
# 0 en produccion: el keeper no se cansa nunca. Un numero finito es para
# pruebas, para que el contenedor termine y avise.
CANGUPA_MAX_ITERATIONS=0
CANGUPA_FINALIZE_ON_EXPIRY=1

# ---------- build ----------
# Version del CLI de Stellar para compilar los contratos. Debe ser la que
# genera protocolo 28.
STELLAR_CLI_VERSION=25.2.0

# ---------- imagenes ----------
CANGUPAY_WEB_IMAGE=cangupay/web:latest
CANGUPAY_AGENT_IMAGE=cangupay/agent:latest

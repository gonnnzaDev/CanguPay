              "name": "EscrowConfig"
            }
          }
        },
        {
          "doc": "",
          "name": "correction_attempts",
          "type": "u32"
        },
        {
          "doc": "`attested_at + correction_period`: hasta ahi el supplier corrige.",
          "name": "correction_deadline",
          "type": {
            "option": {
              "value_type": "u64"
            }
          }
        },
        {
          "doc": "",

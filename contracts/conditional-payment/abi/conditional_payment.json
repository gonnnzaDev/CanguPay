[
  {
    "function_v0": {
      "doc": "Fondea la operaci\\xc3\\xb3n con un pull at\\xc3\\xb3mico: transfiere `amount` desde el\\nbuyer al contrato y pasa a `FUNDED` en la misma operaci\\xc3\\xb3n l\\xc3\\xb3gica. Si\\nel pull falla (p. ej. saldo insuficiente), la llamada revierte\\ncompleta y la operaci\\xc3\\xb3n no queda parcialmente fondeada.",
      "name": "fund",
      "inputs": [],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Lecturas para la UI: estado y configuraci\\xc3\\xb3n vigentes.",
      "name": "state",
      "inputs": [],
      "outputs": [
        {
          "udt": {
            "name": "EscrowState"
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "El engine atestigua PASS o FAIL con su `report_hash`. No mueve fondos.\\nDebe ocurrir antes de `attestation_deadline`.",
      "name": "attest",
      "inputs": [
        {
          "doc": "",
          "name": "outcome",
          "type": {
            "udt": {
              "name": "AttestationOutcome"
            }
          }
        },

  {
    "udt_struct_v0": {
      "doc": "Instantanea completa para lectores externos (agente de atestacion, UI).\\n\\nTodo lo que el motor necesita para decidir va aqui, con nombre: nadie tiene\\nque adivinar la posicion de un campo dentro del `ScVec` ni conocer las\\n`DataKey` privadas. Los plazos que aun no aplican son `None`, y\\n`ledger_timestamp` es el reloj que el propio contrato usa para los plazos.",
      "lib": "",
      "name": "EscrowSnapshot",
      "fields": [
        {
          "doc": "",
          "name": "attestation_deadline",
          "type": {
            "option": {
              "value_type": "u64"
            }
          }
        },
        {

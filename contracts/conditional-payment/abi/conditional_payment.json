          "doc": "",
          "name": "report_hash",
          "type": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Cancela la operaci\\xc3\\xb3n. Solo el buyer, y \\xc3\\xbanicamente antes de fondear.",
      "name": "cancel",
      "inputs": [],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "",
      "name": "config",
      "inputs": [],
      "outputs": [

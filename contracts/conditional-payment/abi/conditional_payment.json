                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "disputed_at",
          "type": {
            "option": {
              "value_type": "u64"
            }
          }
        },
        {
          "doc": "Hash del bundle que el supplier subio; es la entrada del motor.",
          "name": "evidence_bundle_hash",
          "type": {
            "option": {
              "value_type": {
                "bytes_n": {
                  "n": 32
                }
              }
            }

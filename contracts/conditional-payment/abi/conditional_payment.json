          "type": {
            "bytes_n": {
              "n": 32
            }
          }
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "El supplier presenta el hash del bundle de evidencia antes del\\n`submission_deadline` calculado en el fondeo, o como correcci\\xc3\\xb3n \\xc3\\xbanica\\ntras `ATTESTED_FAIL` antes de `correction_deadline`.",
      "name": "submit_evidence",
